# =============================================================================
#  Private MRR — server configuration
#
#  Copy to `.env`, then restrict the permissions:
#      cp .env.example .env && chmod 600 .env
#
#  This file holds your Stripe keys. It must never be committed, never copied
#  into a Docker image, and never backed up in the clear.
# =============================================================================

# --- Network -----------------------------------------------------------------
# The port is published on 127.0.0.1 only (see docker-compose.yml): the service
# is reachable through the host's reverse proxy alone.
PORT=8791
HOST=0.0.0.0
NODE_ENV=production

# Timezone used to bucket "today", "this month" and "this year". Set it to your
# own zone, otherwise a payment late in the evening may land on the wrong day.
TZ=UTC

# --- App authentication ------------------------------------------------------
# The single token the mobile app presents. Generate one with:
#     openssl rand -hex 32
# Revoking it means changing this value and restarting: the app will then ask
# to be configured again.
API_TOKEN=REPLACE_WITH_A_RANDOM_64_CHARACTER_TOKEN

# --- Data --------------------------------------------------------------------
DB_PATH=/data/mrr.db
BASE_CURRENCY=eur

# How much history to import on first boot, in months.
# 24 allows year-over-year comparison.
BACKFILL_MONTHS=24
BACKFILL_ON_BOOT=true

# --- Projects ----------------------------------------------------------------
# One project = one Stripe account. List the ids separated by commas, then
# declare one block per project.
#
# IMPORTANT: always quote the colour. Without quotes, dotenv reads the `#` as
# the start of a comment and the value is lost.
#
# IMPORTANT: prefer a RESTRICTED KEY (rk_live_...) over a full secret key
# (sk_live_...). See the README, Security section.

PROJECTS=project-a,project-b

PROJECT_PROJECT_A_NAME="Project A"
PROJECT_PROJECT_A_STRIPE_KEY=rk_live_xxxxxxxxxxxxxxxxxxxx
PROJECT_PROJECT_A_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
PROJECT_PROJECT_A_COLOR="#6366f1"

PROJECT_PROJECT_B_NAME="Project B"
PROJECT_PROJECT_B_STRIPE_KEY=rk_live_xxxxxxxxxxxxxxxxxxxx
PROJECT_PROJECT_B_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
PROJECT_PROJECT_B_COLOR="#10b981"

# --- Store subscriptions, through RevenueCat ---------------------------------
# A project may be backed by Stripe, by RevenueCat, or by both. Declare a
# RevenueCat block and its App Store / Google Play subscriptions join the same
# consolidated MRR as the Stripe ones.
#
# Amounts are booked NET of the store commission — what actually reaches the
# bank — while the gross is kept alongside so the commission stays auditable.
#
# Three values per project, all from the RevenueCat dashboard:
#   _REVENUECAT_PROJECT_ID   Project settings; the API paths are built from it.
#   _REVENUECAT_KEY          A **v2 secret** key (sk_...). A v1 key will not work.
#                            Read-only permissions are enough.
#   _REVENUECAT_WEBHOOK_AUTH The exact Authorization header value you set under
#                            Integrations -> Webhooks. RevenueCat does not sign
#                            its webhooks: this secret is the only thing
#                            protecting the endpoint. Generate one with:
#                                openssl rand -hex 32
#
# Webhook URL to paste into RevenueCat:
#   https://your-domain/webhooks/revenuecat/<project-id>
#
# Optional. Commission to assume when an event does not carry one, in percent.
# 30 by default, 15 under Apple's Small Business Program and for Google Play's
# first million a year. Set it: guessing wrong skews the revenue by that much.
#   PROJECT_MY_APP_STORE_COMMISSION_PCT=15

PROJECT_MY_APP_NAME="My App"
PROJECT_MY_APP_REVENUECAT_PROJECT_ID=projxxxxxxxx
PROJECT_MY_APP_REVENUECAT_KEY=sk_xxxxxxxxxxxxxxxxxxxx
PROJECT_MY_APP_REVENUECAT_WEBHOOK_AUTH=REPLACE_WITH_A_RANDOM_SECRET
PROJECT_MY_APP_STORE_COMMISSION_PCT=15
PROJECT_MY_APP_COLOR="#ec4899"

# --- Push notifications ------------------------------------------------------
# Firebase service account key, used to send directly through the FCM HTTP v1
# API. Without it everything works except notifications.
# Firebase Console -> Project settings -> Service accounts.
FCM_SERVICE_ACCOUNT_PATH=./credentials/fcm-service-account.json

# --- Miscellaneous -----------------------------------------------------------
# Request quota per minute per IP (Stripe webhooks are exempt).
RATE_LIMIT_MAX=300

# Allowed web origins. Leave empty: the mobile app is not a browser and needs
# no CORS origin.
CORS_ORIGIN=

LOG_LEVEL=info

# Demo mode: no Stripe connection, fictional data (npm run seed).
DEMO_MODE=false
