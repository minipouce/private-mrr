# =============================================================================
#  Private MRR — configuration serveur
#
#  Copier en `.env`, puis restreindre les permissions :
#      cp .env.example .env && chmod 600 .env
#
#  Ce fichier contient les clés Stripe. Il ne doit jamais être versionné,
#  ni copié dans une image Docker, ni sauvegardé en clair.
# =============================================================================

# --- Réseau ------------------------------------------------------------------
# Le port n'est publié que sur 127.0.0.1 (voir docker-compose.yml) : le service
# n'est joignable que par le reverse-proxy de l'hôte.
PORT=8791
HOST=0.0.0.0
NODE_ENV=production
TZ=Europe/Paris

# --- Authentification de l'app ----------------------------------------------
# Jeton unique présenté par l'app mobile. À générer avec :
#     openssl rand -hex 32
# Le révoquer = changer cette valeur et redémarrer : l'app redemandera la config.
API_TOKEN=REMPLACER_PAR_UN_JETON_ALEATOIRE_DE_64_CARACTERES

# --- Données -----------------------------------------------------------------
DB_PATH=/data/mrr.db
BASE_CURRENCY=eur

# Profondeur d'historique importée au premier démarrage, en mois.
# 24 permet la comparaison avec l'année précédente.
BACKFILL_MONTHS=24
BACKFILL_ON_BOOT=true

# --- Projets -----------------------------------------------------------------
# Un projet = un compte Stripe. Lister les identifiants séparés par des virgules,
# puis déclarer un bloc par projet.
#
# IMPORTANT : toujours entourer la couleur de guillemets. Sans cela, dotenv
# interprète le `#` comme un début de commentaire et la valeur est perdue.
#
# IMPORTANT : privilégier une CLÉ RESTREINTE (rk_live_…) plutôt qu'une clé
# secrète complète (sk_live_…). Voir le README, section Sécurité.

PROJECTS=projet-a,projet-b

PROJECT_PROJET_A_NAME="Projet A"
PROJECT_PROJET_A_STRIPE_KEY=rk_live_xxxxxxxxxxxxxxxxxxxx
PROJECT_PROJET_A_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
PROJECT_PROJET_A_COLOR="#6366f1"

PROJECT_PROJET_B_NAME="Projet B"
PROJECT_PROJET_B_STRIPE_KEY=rk_live_xxxxxxxxxxxxxxxxxxxx
PROJECT_PROJET_B_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
PROJECT_PROJET_B_COLOR="#10b981"

# --- Notifications push ------------------------------------------------------
# Clé de compte de service Firebase, utilisée pour envoyer directement via
# l'API FCM HTTP v1. Sans elle, tout fonctionne sauf les notifications.
# Console Firebase -> Paramètres du projet -> Comptes de service.
FCM_SERVICE_ACCOUNT_PATH=./credentials/fcm-service-account.json

# --- Divers ------------------------------------------------------------------
# Quota de requêtes par minute et par IP (les webhooks Stripe en sont exemptés).
RATE_LIMIT_MAX=300

# Origines web autorisées. Laisser vide : l'app mobile n'est pas un navigateur
# et n'a besoin d'aucune origine CORS.
CORS_ORIGIN=

LOG_LEVEL=info

# Mode démonstration : aucune connexion Stripe, données fictives (npm run seed).
DEMO_MODE=false
