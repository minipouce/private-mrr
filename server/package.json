{
  "name": "private-mrr-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-account Stripe aggregation backend: real-time webhooks, MRR metrics, push notifications",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "tsx src/seed.ts",
    "backfill": "tsx src/cli/backfill.ts",
    "typecheck": "tsc --noEmit",
    "test:fcm": "tsx src/cli/test-fcm.ts",
    "add-project": "node scripts/add-project.mjs",
    "sync-logos": "tsx src/cli/sync-logos.ts",
    "replay": "tsx src/cli/replay-webhook.ts",
    "check-keys": "tsx src/cli/check-keys.ts",
    "check-i18n": "tsx src/cli/check-i18n.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.1",
    "stripe": "^22.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.11"
  }
}
