# Snippet to add to your VPS's existing Caddyfile.
# Caddy obtains and renews the Let's Encrypt certificate automatically.

mrr.yourdomain.com {
    encode gzip

    # The SSE stream must never be buffered, otherwise events arrive in bursts
    # instead of live.
    @stream path /api/stream
    reverse_proxy @stream 127.0.0.1:8791 {
        flush_interval -1
    }

    reverse_proxy 127.0.0.1:8791

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        -Server
    }

    log {
        output file /var/log/caddy/mrr.log
        format json
    }
}
